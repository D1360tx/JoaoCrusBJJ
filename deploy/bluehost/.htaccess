DirectoryIndex index.html
Options -Indexes

RewriteEngine On

# Retire legacy WordPress sitelink URLs with one-hop canonical redirects.
RewriteRule ^home-page-2/?$ https://joaocrusbjj.com/ [R=301,L]
RewriteRule ^got-questions/?$ https://joaocrusbjj.com/contact/ [R=301,L]

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.joaocrusbjj\.com$ [NC]
RewriteRule ^ https://joaocrusbjj.com%{REQUEST_URI} [R=301,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>
