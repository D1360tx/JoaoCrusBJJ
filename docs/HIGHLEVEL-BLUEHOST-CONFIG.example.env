# Copy this file to a path OUTSIDE public_html and set GHL_ENV_FILE to that absolute path.
# Placeholders only. Never commit a populated copy.
GHL_PRIVATE_INTEGRATION_TOKEN=replace-with-private-integration-token
GHL_LOCATION_ID=replace-with-location-id
GHL_PIPELINE_ID=replace-with-prospect-enrollment-pipeline-id
GHL_NEW_LEAD_STAGE_ID=replace-with-new-lead-stage-id
GHL_OWNER_USER_ID=replace-with-owner-user-id
LEAD_ALLOWED_ORIGINS=https://joaocrusbjj.com,https://www.joaocrusbjj.com
LEAD_RATE_LIMIT_SALT=replace-with-random-server-only-value
LEAD_ENABLE_LEGACY_EMAIL=true

# Disabled by default. Enable only after the dedicated add-tags endpoint is live-tested.
GHL_ENABLE_TAG_ADD=false

# Secret-free logical-name -> live HighLevel custom-field ID/key contract.
# Required inquiry context fields below must exist before production deployment.
# Add optional attribution keys such as first_utm_source/latest_utm_source only after those fields exist.
GHL_CUSTOM_FIELD_MAP_JSON={"request_id":{"id":"replace-request-id-field-id","key":"contact.request_id"},"form_id":{"id":"replace-form-id-field-id","key":"contact.website_form_id"},"schema_version":{"id":"replace-schema-field-id","key":"contact.website_schema_version"},"lead_type":{"id":"replace-lead-type-field-id","key":"contact.lead_type"},"route_source":{"id":"replace-route-source-field-id","key":"contact.website_route_source"},"recommended_program":{"id":"replace-program-field-id","key":"contact.recommended_program"},"email_consent":{"id":"replace-email-consent-field-id","key":"contact.email_consent_status"},"sms_consent":{"id":"replace-sms-consent-field-id","key":"contact.sms_consent_status"},"consent_disclosure_version":{"id":"replace-disclosure-field-id","key":"contact.consent_disclosure_version"},"consent_timestamp":{"id":"replace-consent-time-field-id","key":"contact.consent_timestamp"},"audience":{"id":"replace-audience-field-id","key":"contact.audience"},"child_count":{"id":"replace-child-count-field-id","key":"contact.child_count"},"age_bands":{"id":"replace-age-bands-field-id","key":"contact.age_bands"},"stage":{"id":"replace-stage-field-id","key":"contact.starting_stage"},"goal":{"id":"replace-goal-field-id","key":"contact.primary_goal"},"experience":{"id":"replace-experience-field-id","key":"contact.experience_level"},"preferred_location":{"id":"replace-location-field-id","key":"contact.preferred_location"},"submission_page":{"id":"replace-page-field-id","key":"contact.submission_page"},"message":{"id":"replace-message-field-id","key":"contact.website_message"},"role":{"id":"replace-role-field-id","key":"contact.inquiry_role"},"age":{"id":"replace-age-field-id","key":"contact.teen_age"},"availability":{"id":"replace-availability-field-id","key":"contact.inquiry_availability"}}
