+import hashlib
+import unittest
+from unittest.mock import patch
+from datetime import datetime, timezone
+import crm_coverage as cc
+
+class PageClient:
+    def __init__(self, pages): self.pages=iter(pages); self.calls=[]
+    def request(self, method, path, *, params):
+        self.calls.append((method,path,params)); return next(self.pages)
+
+def page(ids,total=None,cursor=None,**meta):
+    if total is not None: meta['total']=total
+    if cursor is not None: meta.update(startAfter=cursor,startAfterId='cursor_'+str(cursor),nextPage=True)
+    return {'contacts':[{'id':str(i)} for i in ids], 'meta':meta}
+
+class CoverageTests(unittest.TestCase):
+    def scan(self,pages,**kwargs):
+        client=PageClient(pages)
+        rows,receipt=cc.census(client,'/contacts/','contacts',{'locationId':'loc','limit':100},**kwargs)
+        self.assertTrue(all(c[0]=='GET' for c in client.calls))
+        return rows,receipt,client
+    def test_exhausts_beyond_five_pages(self):
+        rows,r,c=self.scan([page([i],7,i) for i in range(7)])
+        self.assertEqual(len(rows),7); self.assertEqual(r['pages'],7); self.assertTrue(r['exhausted'])
+        self.assertEqual(c.calls[1][2]['startAfter'],0)
+    def test_total_wins_over_stale_next_page(self):
+        _,r,c=self.scan([page([1],1,1)])
+        self.assertTrue(r['exhausted']);self.assertEqual(len(c.calls),1)
+    def test_repeated_page_not_verified(self):
+        _,r,_=self.scan([page([1],3,1),page([1],3,2)])
+        self.assertFalse(r['exhausted']); self.assertEqual(r['reason'],'pagination_no_progress')
+    def test_changing_total_not_verified(self):
+        _,r,_=self.scan([page([1],3,1),page([2],4,2)])
+        self.assertFalse(r['exhausted']);self.assertEqual(r['reason'],'provider_total_changed_during_scan')
+    def test_hard_cap_not_verified(self):
+        _,r,_=self.scan([page([1],3,1)],max_pages=1)
+        self.assertEqual(r['reason'],'page_safety_cap_reached');self.assertFalse(r['exhausted'])
+    def test_missing_cursor_partial(self):
+        _,r,_=self.scan([page([1],3)])
+        self.assertFalse(r['exhausted'])
+    def test_unknown_host_rejected(self):
+        _,r,c=self.scan([page([1],3,nextPageUrl='https://evil.example/contacts/?startAfter=1&startAfterId=x')])
+        self.assertEqual(r['reason'],'unsafe_next_page_url');self.assertEqual(len(c.calls),1)
+    def test_location_mismatch_rejected(self):
+        _,r,_=self.scan([page([1],3,nextPageUrl='https://services.leadconnectorhq.com/contacts/?locationId=other&startAfter=1&startAfterId=x')])
+        self.assertEqual(r['reason'],'next_page_location_mismatch')
+    def test_valid_next_url_only_supplies_cursors(self):
+        _,r,c=self.scan([page([1],2,nextPageUrl='https://services.leadconnectorhq.com/contacts/?locationId=loc&startAfter=1&startAfterId=x'),page([2],2)])
+        self.assertTrue(r['exhausted']);self.assertEqual(c.calls[1][2]['locationId'],'loc')
+    def test_empty_page_must_reconcile_total(self):
+        _,r,_=self.scan([page([],2)])
+        self.assertFalse(r['exhausted'])
+    def evidence(self,notes,tags=None):
+        return cc.submission_evidence([{'id':'contact_1','tags':tags or []}],{'contact_1':notes},datetime(2026,8,27,tzinfo=timezone.utc),datetime(2026,9,30,tzinfo=timezone.utc))
+    def note(self,request='request-00000001',date='2026-09-01T10:00:00Z'):
+        return {'id':'note_1','body':f'Website submission accepted by HighLevel.\nOriginal submission at: {date}\nRequest ID: {request}'}
+    def test_accepted_note_survives_tag_removal(self):
+        r=self.evidence([self.note()]);self.assertEqual(len(r['events']),1);self.assertEqual(r['quality']['accepted_notes_without_current_tag'],1)
+    def test_request_deduplication(self):
+        r=self.evidence([self.note(),self.note()]);self.assertEqual(len(r['events']),1);self.assertEqual(r['quality']['duplicate_request_notes'],1)
+    def test_original_time_not_note_time(self):
+        n=self.note();n['dateAdded']='2026-10-30T00:00:00Z';self.assertEqual(len(self.evidence([n])['events']),1)
+    def test_html_and_entities_normalized(self):
+        n=self.note();n['body']=n['body'].replace('\n','<br />');self.assertEqual(len(self.evidence([n])['events']),1)
+    def test_bad_timestamp_not_silent_zero(self):
+        r=self.evidence([self.note(date='invalid')]);self.assertEqual(r['quality']['unparseable_dates'],1)
+    def test_note_date_fallback_explicit(self):
+        n={'id':'note_1','body':'Website submission accepted by HighLevel.\nRequest ID: request-00000001','dateAdded':'2026-09-01T00:00:00Z'}
+        self.assertEqual(self.evidence([n])['quality']['note_date_fallbacks'],1)
+    def test_exact_qa_request_excluded_without_name_heuristic(self):
+        rid='exact-fixture-000001'
+        with patch.object(cc,'QA_REQUEST_SHA256',{hashlib.sha256(rid.encode()).hexdigest()}):
+            r=self.evidence([self.note(rid)]);self.assertEqual(len(r['events']),0);self.assertEqual(r['quality']['excluded_qa_requests'],1)
+    def test_conflicting_request_identity_flagged(self):
+        r=self.evidence([self.note(),self.note(date='2026-09-02T10:00:00Z')]);self.assertEqual(r['quality']['request_identity_conflicts'],1)
+
+    def test_legacy_submitted_at_utc_precedes_note_creation(self):
+        n={'id':'note_1','body':'Website submission accepted by HighLevel.\nSubmitted at: 2026-09-01 10:00:00 UTC\nRequest ID: request-00000001','dateAdded':'2026-10-30T00:00:00Z'}
+        r=self.evidence([n]);self.assertEqual(len(r['events']),1);self.assertEqual(r['quality']['note_date_fallbacks'],0)
+    def test_malformed_explicit_legacy_date_does_not_use_note_date(self):
+        n={'id':'note_1','body':'Website submission accepted by HighLevel.\nSubmitted at: invalid\nRequest ID: request-00000001','dateAdded':'2026-09-01T00:00:00Z'}
+        self.assertEqual(self.evidence([n])['quality']['unparseable_dates'],1)
+    def test_note_read_error_is_partial(self):
+        from types import SimpleNamespace
+        class Client:
+            def request(self,method,path,*,params):
+                return {'contacts':[{'id':'contact_1'}],'meta':{'total':1}} if path=='/contacts/' else {'opportunities':[],'meta':{'total':0}}
+        def fail(cid):raise RuntimeError('private provider error')
+        gw=SimpleNamespace(client=Client(),_loc=lambda p:p,notes=fail,s=SimpleNamespace(location_id='loc'))
+        r=cc.collect(gw)
+        self.assertFalse(r['coverage']['notes_complete']);self.assertEqual(r['coverage']['notes_error_count'],1)
+        self.assertNotIn('private provider error',str(r))
+    def test_opportunity_census_also_exhausts(self):
+        c=PageClient([{'opportunities':[{'id':'opp_1'}],'meta':{'total':2,'startAfter':1,'startAfterId':'opp_1'}},{'opportunities':[{'id':'opp_2'}],'meta':{'total':2}}])
+        rows,r=cc.census(c,'/opportunities/search','opportunities',{'location_id':'loc','limit':100})
+        self.assertTrue(r['exhausted']);self.assertEqual(len(rows),2)
+
+if __name__=='__main__':unittest.main()
