@@ -0,0 +1,226 @@
+"""GET-only retained CRM census. Completeness is evidence, not a page-size guess."""
+from __future__ import annotations
+import json
+import os
+import threading
+import time
+from concurrent.futures import ThreadPoolExecutor
+from datetime import datetime, timezone
+from pathlib import Path
+from urllib.parse import urlparse, parse_qs
+
+MAX_PAGES = 100
+CACHE_TTL_SECONDS = 600
+# Exact disposable acceptance requests (Oct26 CAPI, Oct29 lifecycle x2).
+# Hashes avoid publishing request identifiers; never infer QA from a real name.
+QA_REQUEST_SHA256 = frozenset({
+    "7dc2e7f2cf823f882f7c8e16b6e040aedf6705425e3f7483002b264bae49131a",
+    "b717215353655cd66774fa682e1664e6e8cc382597749e462d844a05f046b306",
+    "8c4c70d87edc3e96cd700bbbbc8ac1ba062c1ce7a38233a12df3ea51d1b05871",
+})
+
+def utc_now():
+    return datetime.now(timezone.utc).isoformat()
+
+def census(client, path, key, params, *, max_pages=MAX_PAGES):
+    """Follow documented startAfter/startAfterId, never an authenticated URL."""
+    rows, seen, totals, cursors = [], set(), set(), set()
+    base = dict(params)
+    receipt = {"pages": 0, "unique_records": 0, "declared_total": None,
+               "exhausted": False, "reason": None, "duplicate_records": 0}
+    for _ in range(max_pages):
+        payload = client.request("GET", path, params=params)
+        batch = payload.get(key) if isinstance(payload, dict) else None
+        if not isinstance(batch, list) or not all(isinstance(r, dict) for r in batch):
+            receipt["reason"] = "invalid_collection"; break
+        meta = payload.get("meta") or {}
+        receipt["pages"] += 1
+        total = meta.get("total", payload.get("total"))
+        if type(total) is int and total >= 0:
+            totals.add(total); receipt["declared_total"] = total
+        else:
+            total = None
+        before = len(seen)
+        for row in batch:
+            rid = row.get("id") or row.get("_id")
+            if not isinstance(rid, str) or not rid:
+                receipt["reason"] = "missing_record_id"; continue
+            if rid in seen:
+                receipt["duplicate_records"] += 1; continue
+            seen.add(rid); rows.append(row)
+        receipt["unique_records"] = len(seen)
+        if receipt["reason"]: break
+        if len(totals) > 1:
+            receipt["reason"] = "provider_total_changed_during_scan"; break
+        if total is not None and len(seen) == total:
+            receipt["exhausted"] = True; break
+        if not batch:
+            receipt["exhausted"] = total is None or len(seen) == total
+            receipt["reason"] = None if receipt["exhausted"] else "empty_page_total_mismatch"
+            break
+        if len(seen) == before:
+            receipt["reason"] = "pagination_no_progress"; break
+        cursor = {k: meta[k] for k in ("startAfter", "startAfterId") if meta.get(k) is not None}
+        next_url = meta.get("nextPageUrl")
+        if next_url:
+            url = urlparse(next_url)
+            if url.scheme != "https" or url.netloc != "services.leadconnectorhq.com" or url.path.rstrip("/") != path.rstrip("/") or url.username or url.password or url.fragment:
+                receipt["reason"] = "unsafe_next_page_url"; break
+            query = parse_qs(url.query)
+            if any(k not in {"locationId", "location_id", "query", "limit", "startAfter", "startAfterId", "page"} for k in query):
+                receipt["reason"] = "unsupported_next_page_query"; break
+            if any(query[k] != [str(base[k])] for k in ("locationId", "location_id") if k in query and k in base):
+                receipt["reason"] = "next_page_location_mismatch"; break
+            if len(cursor) != 2:
+                cursor = {k: query[k][0] for k in ("startAfter", "startAfterId") if len(query.get(k, [])) == 1}
+        if len(cursor) != 2:
+            receipt["reason"] = "missing_provider_cursor_or_total"; break
+        fingerprint = tuple(str(cursor[k]) for k in ("startAfter", "startAfterId"))
+        if fingerprint in cursors:
+            receipt["reason"] = "repeated_provider_cursor"; break
+        cursors.add(fingerprint)
+        params = {**base, **cursor}
+    else:
+        receipt["reason"] = "page_safety_cap_reached"
+    return rows, receipt
+
+class ReadLimiter:
+    def __init__(self, client=None):
+        self.lock = threading.Lock(); self.next_at = 0.0; self.client = client
+    def wait(self):
+        with self.lock:
+            delay = max(0, self.next_at - time.monotonic())
+            if delay: time.sleep(delay)
+            self.next_at = time.monotonic() + getattr(self.client, "read_spacing", 0.45)
+
+def private_json(path, payload):
+    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+    temp = path.with_suffix(path.suffix + ".tmp")
+    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+    with os.fdopen(fd, "w") as f: json.dump(payload, f)
+    os.chmod(temp, 0o600); os.replace(temp, path)
+
+def collect(gateway, *, checkpoint=None):
+    """Scan every retained contact's notes; current tags are not event evidence."""
+    started = utc_now()
+    contacts, contact_receipt = census(gateway.client, "/contacts/", "contacts", gateway._loc({"query": "", "limit": 100}))
+    # Minimize the private materialization: no names, email, phone or addresses.
+    contacts = [{k: r[k] for k in ("id", "dateAdded", "tags", "customFields") if k in r} for r in contacts]
+    notes, errors, note_count = {}, {}, 0
+    limiter = ReadLimiter(gateway.client)
+    progress = Path(checkpoint) if checkpoint else None
+    # Resume only this explicitly selected collection checkpoint, never a general
+    # long-lived note cache (notes can change independently of contactUpdated).
+    if progress and progress.exists():
+        for line in progress.read_text().splitlines():
+            row = json.loads(line)
+            if "notes" in row: notes[row["contact_id"]] = row["notes"]
+    pending = [c["id"] for c in contacts if c["id"] not in notes]
+    def one(cid):
+        limiter.wait()
+        try:
+            payload = gateway.notes(cid)
+            result = payload.get("notes") if isinstance(payload, dict) else None
+            if not isinstance(result, list) or not all(isinstance(n, dict) for n in result):
+                return cid, None, "invalid_notes_collection"
+            if payload.get("meta", {}).get("nextPage") or payload.get("hasMore"):
+                return cid, None, "notes_pagination_unresolved"
+            return cid, result, None
+        except Exception as exc:
+            # Exception type only: never echo provider bodies, IDs or credentials.
+            return cid, None, type(exc).__name__
+    with ThreadPoolExecutor(max_workers=4) as pool:
+        for cid, result, error in pool.map(one, pending):
+            if error: errors[cid] = error
+            else:
+                notes[cid] = result
+                if progress:
+                    progress.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+                    fd = os.open(progress, os.O_APPEND | os.O_CREAT | os.O_WRONLY, 0o600)
+                    with os.fdopen(fd, "a") as f: f.write(json.dumps({"contact_id": cid, "notes": result}) + "\n")
+    opportunities, opp_receipt = census(gateway.client, "/opportunities/search", "opportunities", {"location_id": gateway.s.location_id, "limit": 100})
+    opportunities = [{k: row[k] for k in ("id", "contactId", "pipelineId", "pipelineStageId", "status") if k in row} for row in opportunities]
+    note_count = sum(len(v) for v in notes.values())
+    return {"schema_version": 1, "location_id": gateway.s.location_id, "started_at": started, "finished_at": utc_now(),
+            "contacts": contacts, "notes": notes, "note_errors": errors, "opportunities": opportunities,
+            "coverage": {"contacts": contact_receipt, "opportunities": opp_receipt,
+                         "notes_contacts_scanned": len(notes), "notes_count": note_count,
+                         "notes_error_count": len(errors), "notes_complete": len(notes) == len(contacts) and not errors,
+                         "consistency": "non_transactional_retained_state_scan", "history_reconciled": False}}
+
+def retained_snapshot(gateway):
+    # Only real clients are cached; tests/custom transports must not read live PII.
+    if not hasattr(gateway.client, "http") or gateway.client.http._transport.__class__.__name__ == "MockTransport":
+        return collect(gateway)
+    import hashlib
+    key = hashlib.sha256(gateway.s.location_id.encode()).hexdigest()[:20]
+    path = gateway.s.state_file.parent / "crm-coverage" / ("crm-retained-" + key + ".json")
+    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+    os.chmod(path.parent, 0o700)
+    import fcntl
+    lock_fd = os.open(path.with_suffix(".lock"), os.O_CREAT | os.O_RDWR, 0o600)
+    with os.fdopen(lock_fd, "a") as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX)
+        if path.exists() and 0 <= time.time() - path.stat().st_mtime < CACHE_TTL_SECONDS:
+            try:
+                cached = json.loads(path.read_text())
+                finished = datetime.fromisoformat(cached.get("finished_at", ""))
+                age = (datetime.now(timezone.utc) - finished).total_seconds()
+                if cached.get("schema_version") == 1 and cached.get("location_id") == gateway.s.location_id and 0 <= age < CACHE_TTL_SECONDS:
+                    return cached
+            except (ValueError, OSError):
+                pass
+        result = collect(gateway)
+        private_json(path, result)
+        return result
+
+
+def normalized_note_body(note):
+    import html
+    import re
+    body = str(note.get("bodyText") or note.get("body") or note.get("text") or "")
+    body = re.sub(r"(?i)<(?:br\s*/?|/p|/div)>", "\n", body)
+    return html.unescape(re.sub(r"<[^>]+>", "", body)).replace("\u00a0", " ").strip()
+
+
+def submission_evidence(contacts, notes, start, end):
+    from gateway import _website_submission_time, _website_submission_request_id
+    import re
+    events = {}
+    quality = {"accepted_notes_all_dates": 0, "unparseable_dates": 0,
+               "note_date_fallbacks": 0, "idless_requests": 0,
+               "request_identity_conflicts": 0, "duplicate_request_notes": 0,
+               "accepted_notes_without_current_tag": 0, "excluded_qa_requests": 0}
+    tags = {c["id"]: c.get("tags", []) for c in contacts}
+    all_events = {}
+    for cid, note_rows in notes.items():
+        for note in note_rows:
+            body = normalized_note_body(note)
+            if str(note.get("title") or "") != "Website Quiz Submitted" and not body.startswith("Website submission accepted by HighLevel."):
+                continue
+            quality["accepted_notes_all_dates"] += 1
+            if "website_lead" not in tags.get(cid, []):
+                quality["accepted_notes_without_current_tag"] += 1
+            submitted = _website_submission_time(body, note)
+            if submitted is None:
+                quality["unparseable_dates"] += 1; continue
+            if not re.search(r"(?im)^(?:Original submission at|Submitted at):\s*", body):
+                quality["note_date_fallbacks"] += 1
+            request_id = _website_submission_request_id(body)
+            import hashlib
+            if request_id and hashlib.sha256(request_id.encode()).hexdigest() in QA_REQUEST_SHA256:
+                quality["excluded_qa_requests"] += 1
+                continue
+            if not request_id:
+                quality["idless_requests"] += 1
+            key = request_id or "note:" + str(note.get("id") or cid + ":" + submitted.isoformat())
+            value = (cid, submitted)
+            if key in all_events:
+                quality["duplicate_request_notes"] += 1
+                if all_events[key] != value:
+                    quality["request_identity_conflicts"] += 1
+            else:
+                all_events[key] = value
+            if start <= submitted < end:
+                events.setdefault(key, value)
+    return {"events": events, "quality": quality}
